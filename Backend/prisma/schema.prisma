generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id           String   @id
  name         String
  logo         String?
  description  String
  email        String   @unique
  location     String
  passwordHash String?
  jobs         Job[]
}

model Job {
  id           String        @id
  title        String
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  city         String
  salary       String
  type         String
  description  String
  requirements Json          // array de strings, ej. ["req1","req2"]
  postedAt     DateTime      @default(now())
  applications Application[]
}

model Admin {
  id           String   @id
  email        String   @unique
  passwordHash String
  name         String
  avatar       String?
  createdAt    DateTime @default(now())
}

model User {
  id           String   @id
  name         String
  email        String   @unique
  avatar       String?
  description  String
  cvUrl        String?
  passwordHash String?
  applications Application[]
}

model Application {
  id        String   @id
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userCity  String
  cvUrl     String
  message   String?
  appliedAt DateTime @default(now())
}
