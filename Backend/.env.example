PORT=4000

# Base de datos (PostgreSQL en Render). En Render agregar DATABASE_URL desde el panel de la DB.
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Producción (Render): la API está bajo /api (ej. /api/jobs). En el front (Vercel) usar:
# NEXT_PUBLIC_API_URL=https://rednordeste-api.onrender.com/api

# Producción (Render + dominio): CORS
# CORS_ORIGIN=https://rednordeste.vercel.app

# JWT para login de administrador (cambiar en producción)
# JWT_SECRET=tu-clave-secreta-muy-segura
